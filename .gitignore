# Ambiente virtual e cache do Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Pesos do YOLO (baixados automaticamente na 1ª execução)
*.pt
*.onnx

# Resultados gerados pelo monitorar.py (eventos, resumos, vídeos)
saida/*
!saida/.gitkeep

# Vídeos de entrada (grandes demais para o GitHub; ver README)
videos/*
!videos/.gitkeep
*.mp4
*.avi
*.mov
*.mkv

# Editores e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Credenciais (ex.: URL RTSP com usuário e senha)
.env
